{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "preview": "vite preview",
    "i18n:extract": "formatjs extract \"src/**/*.{ts,tsx}\" --ignore \"src/**/*.test.{ts,tsx}\" --out-file lang/en-US.json",
    "i18n:compile": "formatjs compile lang/en-US.json --ast --pseudo-locale en-XA --out-file src/i18n/compiled/en-XA.json",
    "i18n": "bun run i18n:extract && bun run i18n:compile",
    "mutate": "stryker run"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/fredoka": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "daisyui": "5.7.47",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-intl": "12.1.3",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@formatjs/cli": "6.16.32",
    "@stryker-mutator/core": "10.0.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "30.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "^8.2.2",
    "vitest": "5.0.3"
  },
  "trustedDependencies": [],
  "overrides": {
    "postcss": "8.5.28",
    "esbuild": "0.28.2",
    "minimatch@3.1.5": {
      "brace-expansion": "2.1.4"
    }
  }
}
