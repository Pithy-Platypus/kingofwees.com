{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "preview": "vite preview",
    "i18n:extract": "formatjs extract \"src/**/*.{ts,tsx}\" --ignore \"src/**/*.test.{ts,tsx}\" --out-file lang/en-US.json",
    "i18n:compile": "formatjs compile lang/en-US.json --ast --pseudo-locale en-XA --out-file src/i18n/compiled/en-XA.json",
    "i18n": "bun run i18n:extract && bun run i18n:compile",
    "mutate": "stryker run"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/fredoka": "5.3.0",
    "@tailwindcss/vite": "4.3.4",
    "daisyui": "5.7.50",
    "leaflet": "1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-intl": "12.1.6",
    "tailwindcss": "4.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@formatjs/cli": "6.18.0",
    "@stryker-mutator/core": "10.1.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.14.0",
    "jsdom": "31.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.6",
    "vitest": "5.1.0"
  },
  "trustedDependencies": [],
  "overrides": {
    "qs": "6.17.1"
  }
}
