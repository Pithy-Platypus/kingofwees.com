  "about.honor": [
    {
      "type": 0,
      "value": "["
    },
    {
      "type": 0,
      "value": "Ȧƞẏǿǿƞḗḗ ƈȧȧƞ ƥǿǿşŧ — ẇḗḗ ŧřŭŭşŧ ǿǿŭŭř ƞḗḗīɠħƀǿǿřş. Ḗƞŧřīḗḗş ŧħȧȧŧ ŀǿǿǿǿķ ŀīķḗḗ şƥȧȧḿ ƈȧȧƞ ƀḗḗ ħīḓḓḗḗƞ ƀẏ ŧħḗḗ şīŧḗḗ’ş ƈȧȧřḗḗŧȧȧķḗḗřş. Īƒ şƥȧȧḿ ķḗḗḗḗƥş şħǿǿẇīƞɠ ŭŭƥ, ẇḗḗ’ŀŀ ȧȧḓḓ ȧȧ ƞḗḗīɠħƀǿǿřħǿǿǿǿḓ ƈǿǿḓḗḗ ǿǿř şīɠƞ-īƞ. Ķīḓş ȧȧřḗḗ ẇḗḗŀƈǿǿḿḗḗ ŧǿǿ ħḗḗŀƥ ẇīŧħ ȧȧ ɠřǿǿẇƞ-ŭŭƥ’ş ǾĶ."
    },
    {
      "type": 0,
      "value": "]"
    }
  ],
