{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "bun run test"
  },
  "coverageAnalysis": "off",
  "mutate": [
    "src/App.tsx",
    "src/king/api.ts",
    "src/king/location.ts",
    "src/king/messages.ts",
    "src/king/reporter.ts",
    "src/king/time.ts",
    "src/i18n/locale.ts",
    "src/routing/routes.ts"
  ],
  "reporters": [
    "clear-text",
    "html",
    "progress"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "tempDirName": ".stryker-tmp",
  "concurrency": 2,
  "timeoutMS": 30000,
  "incremental": true
}
